<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SsrWasm</RootNamespace>
    <AssemblyName>server</AssemblyName>
    <!-- The chiseled runtime image has no ICU; nothing here needs culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The test project lives under tests/; keep its files out of this one. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <!-- Extism's native library is picked per runtime identifier. Default to the SDK's own
         (linux-x64 in the Docker build, osx-arm64 on an Apple Silicon Mac, ...), override with
         -p:ExtismRuntime=linux-arm64 etc. -->
    <ExtismRuntime Condition="'$(ExtismRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</ExtismRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Extism.Sdk" Version="1.10.0" />
    <!-- libextism (wasmtime) for the platform; Extism.Sdk only contains the P/Invoke bindings. -->
    <PackageReference Include="Extism.runtime.$(ExtismRuntime)" Version="1.13.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetAspnet.Tests" />
  </ItemGroup>

</Project>
