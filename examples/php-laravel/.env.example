APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Nothing here needs a database: keep sessions and cache in memory.
SESSION_DRIVER=array
CACHE_STORE=array

OCTANE_SERVER=frankenphp

# Defaults point into the repo checkout (see config/ssr.php).
# SSR_WASM_PATH=../../packages/components/dist/ssr-wasm/index.wasm
# STENCIL_CLIENT_DIR=../../packages/components/dist/loader-bundle/demo-components
